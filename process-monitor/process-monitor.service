[Unit]
Description=process monitor service
SourcePath=/usr/sbin/processmonitor
After=default.target faultmgr.service firmware.mount
Requires=faultmgr.service


[Service]
Type=simple
ExecStart=/usr/sbin/processmonitor
Restart=on-failure
RestartSec=0s
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=local-fs.target
