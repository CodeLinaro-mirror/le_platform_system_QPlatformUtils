[Unit]
Description=process monitor for CINDERDU
ConditionPathExists=/sys/devices/soc0/machine
SourcePath=/usr/sbin/processmonitor
After=default.target faultmgr.service
Requires=faultmgr.service


[Service]
Type=simple
ExecStartPre=/etc/processmonitor-check-cinder.sh
ExecStart=/usr/sbin/processmonitor
Restart=on-failure
RestartSec=0s
RestartPreventExitStatus=99
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=local-fs.target
